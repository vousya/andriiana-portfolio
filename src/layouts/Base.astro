---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Андріяна — SMM-спеціаліст | Портфоліо',
  description = 'Портфоліо SMM-спеціаліста Андріяни: 4 роки досвіду, кейси get_get, vesna.care, Ваш Лаваш, promtehservice.',
} = Astro.props;
---

<!doctype html>
<html lang="uk">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      rel="icon"
      type="image/svg+xml"
      href={`${import.meta.env.BASE_URL}favicon.svg`}
    />
    <meta name="generator" content={Astro.generator} />

    <!-- Inter (Latin + Cyrillic) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,400..900;1,14..32,400..900&display=swap"
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#090909" />
  </head>
  <body class="bg-ink text-paper">
    <slot />

    <!-- Scroll-reveal: external same-origin script so a strict CSP (script-src
         'self') allows it without 'unsafe-inline'. is:inline keeps Astro from
         re-bundling it back into the HTML. -->
    <script is:inline src={`${import.meta.env.BASE_URL}reveal.js`}></script>
  </body>
</html>
