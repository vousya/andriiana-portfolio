---
// Hero — rebuilds the cover slide: PORTFOLIO / SMM-спеціаліст / 2026
---

<section
  id="top"
  class="relative flex min-h-screen flex-col justify-center overflow-hidden px-5 pt-24 pb-16 sm:px-8"
>
  <!-- decorative glow blobs -->
  <div
    class="pointer-events-none absolute -top-32 -right-24 h-[28rem] w-[28rem] rounded-full bg-pink/25 blur-[120px]"
  >
  </div>
  <div
    class="pointer-events-none absolute bottom-0 -left-24 h-[26rem] w-[26rem] rounded-full bg-teal/15 blur-[120px]"
  >
  </div>

  <div class="relative mx-auto w-full max-w-7xl">
    <p
      class="reveal mb-6 flex items-center gap-3 text-sm font-medium tracking-[0.25em] text-white/50 uppercase"
    >
      <span class="h-px w-10 bg-white/30"></span>Портфоліо · 2026
    </p>

    <h1
      class="display text-[18vw] leading-[0.85] sm:text-[14vw] lg:text-[12rem]"
    >
      <span class="reveal block">PORT</span>
      <span class="reveal block text-pink" style="transition-delay:90ms">FOLIO</span>
    </h1>

    <div
      class="reveal mt-8 flex flex-wrap items-center gap-4"
      style="transition-delay:180ms"
    >
      <span class="pill bg-pink text-base sm:text-lg">SMM-спеціаліст</span>
      <span class="text-base text-white/60 sm:text-lg">
        4 роки досвіду · стратегія · контент · блогери
      </span>
    </div>

    <a
      href="#about"
      class="reveal mt-14 inline-flex items-center gap-2 text-sm font-medium text-white/50 transition-colors hover:text-pink"
      style="transition-delay:260ms"
    >
      <span
        class="grid h-9 w-9 place-items-center rounded-full border border-white/20"
      >↓</span>
      Дізнатися більше
    </a>
  </div>
</section>
