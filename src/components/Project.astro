---
const { project: p } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<article
  id={p.id}
  class="project scroll-mt-20 border-t border-white/10 px-5 py-24 sm:px-8 sm:py-32"
  style={`--accent:${p.accent}`}
>
  <div class="mx-auto max-w-7xl">
    <!-- Title card -->
    <div class="grid items-stretch gap-8 lg:grid-cols-[1.15fr_0.85fr]">
      <div class="flex flex-col justify-center">
        <p
          class="reveal display text-6xl text-white/15 sm:text-7xl lg:text-8xl"
        >
          ПРОЄКТ {p.num}
        </p>
        <h3 class="reveal mt-3 text-3xl font-bold sm:text-4xl">
          {p.name}
          <span class="font-normal text-white/40">| {p.niche}</span>
        </h3>
        <p class="reveal mt-1 text-lg text-white/50">{p.role}</p>
        <div class="reveal mt-5">
          <span
            class="pill text-base text-ink"
            style="background:var(--accent)"
          >
            {p.period}
          </span>
        </div>
      </div>

      <!-- Accent logo panel -->
      <div
        class="reveal grid min-h-44 place-items-center rounded-[var(--radius-card)] p-8 lg:min-h-0"
        style="background:var(--accent)"
      >
        <span
          class="display whitespace-pre-line text-center text-6xl leading-[0.9] text-ink sm:text-7xl"
        >
          {p.logo}
        </span>
      </div>
    </div>

    <!-- Tasks -->
    <div class="mt-16 grid gap-10 lg:grid-cols-[0.9fr_1.1fr]">
      <h4 class="reveal display text-3xl sm:text-4xl">
        Задачі, які стояли<br />переді мною
      </h4>
      <ul class="space-y-3">
        {
          p.tasks.map((t: string, i: number) => (
            <li
              class="reveal flex gap-3 text-lg text-white/80"
              style={`transition-delay:${i * 50}ms`}
            >
              <span
                class="mt-2 h-2 w-2 shrink-0 rounded-full"
                style="background:var(--accent)"
              />
              {t}
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Goal (optional) -->
    {
      p.goal && (
        <div class="reveal mt-16 rounded-[var(--radius-card)] bg-ink-soft p-8 sm:p-12">
          <h4 class="display mb-8 text-3xl sm:text-4xl">Основна ціль:</h4>
          <div class="flex flex-col items-start gap-6 sm:flex-row sm:items-center sm:gap-10">
            <span class="pill bg-teal max-w-md text-base sm:text-lg">
              {p.goal.target}
            </span>
            <span class="hidden text-3xl text-white/30 sm:inline">→</span>
            <span class="pill bg-pink text-base sm:text-lg">
              {p.goal.result}
            </span>
          </div>
          <p class="mt-6 max-w-xl text-lg text-white/60">{p.goal.note}</p>
        </div>
      )
    }

    <!-- Gallery (optional) -->
    {
      p.gallery.length > 0 && (
        <div class="mt-16">
          <div
            class="grid gap-5 sm:grid-cols-2"
            class:list={[
              p.gallery.length >= 4 ? 'lg:grid-cols-4' : 'lg:grid-cols-3',
            ]}
          >
            {p.gallery.map((g: { img: string; label: string }, i: number) => (
              <figure
                class="reveal group overflow-hidden rounded-2xl border border-white/10 bg-ink-soft"
                style={`transition-delay:${i * 60}ms`}
              >
                <div class="overflow-hidden">
                  <img
                    src={base + g.img}
                    alt={`${p.name} — ${g.label}`}
                    loading="lazy"
                    class="aspect-video w-full object-cover transition-transform duration-500 group-hover:scale-105"
                  />
                </div>
                <figcaption class="flex items-center gap-2 px-4 py-3 text-sm font-medium text-white/70">
                  <span
                    class="h-2 w-2 rounded-full"
                    style="background:var(--accent)"
                  />
                  {g.label}
                </figcaption>
              </figure>
            ))}
          </div>
        </div>
      )
    }

    <!-- Achievements (optional) -->
    {
      p.achievements.length > 0 && (
        <div class="mt-16 grid gap-10 lg:grid-cols-[0.9fr_1.1fr]">
          <h4 class="reveal display text-3xl sm:text-4xl">
            Досягнення
            <br />в роботі
          </h4>
          <ul class="space-y-3">
            {p.achievements.map((a: string, i: number) => (
              <li
                class="reveal flex gap-3 rounded-xl bg-white/[0.03] p-4 text-lg text-white/85"
                style={`transition-delay:${i * 50}ms`}
              >
                <span class="shrink-0 font-bold" style="color:var(--accent)">
                  ✓
                </span>
                {a}
              </li>
            ))}
          </ul>
        </div>
      )
    }

    {
      p.gallery.length === 0 && p.achievements.length === 0 && (
        <p class="reveal mt-10 text-lg text-white/40">
          Проєкт у роботі — кейс поповнюється результатами. 🚀
        </p>
      )
    }
  </div>
</article>
